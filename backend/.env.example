# Copiar este archivo a ".env" y completar los valores reales en el entorno local.
# NUNCA subir el archivo ".env" al repositorio ni colocar secretos reales aqui.

NODE_ENV=development
PORT=3001

# Cadena de conexion a PostgreSQL (con PostGIS). No se imprime en logs ni errores.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/denuncias_cercado

# Origen autorizado del frontend para CORS (nunca comodin "*" en produccion).
FRONTEND_ORIGIN=http://localhost:5173

# Nombre de la cookie de sesion (HttpOnly) que se usara en la Fase 2.
SESSION_COOKIE_NAME=denuncias_session
# Secreto largo y aleatorio. En produccion debe ser obligatoriamente distinto al de ejemplo.
SESSION_SECRET=REEMPLAZAR_POR_UN_SECRETO_LARGO_ALEATORIO

# Credenciales de Google OAuth (se configuraran en la Fase 2; dejar vacias por ahora).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Opcionales (valor por defecto entre parentesis)
# Duracion de la sesion en segundos (28800 = 8 horas)
# SESSION_TTL_SECONDS=28800
# Limite general de peticiones por minuto (100)
# GENERAL_RATE_LIMIT_MAX=100
# Limite de peticiones a las rutas de autenticacion cada 15 minutos (10)
# AUTH_RATE_LIMIT_MAX=10

# Fase 4: almacenamiento local de evidencias (privado, jamas servido)
# STORAGE_DIRECTORY=./storage
# Reglas de evidencia: 3 imagenes <=5 MB; 1 video <=50 MB y <=30 segundos
# EVIDENCE_MAX_IMAGES=3
# EVIDENCE_MAX_IMAGE_MB=5
# EVIDENCE_MAX_VIDEOS=1
# EVIDENCE_MAX_VIDEO_MB=50
# EVIDENCE_MAX_VIDEO_SECONDS=30
# Barrido periodico de la ventana de gracia en server.js (true)
# GRACE_SWEEP_ENABLED=true
# Radio de busqueda de denuncias duplicadas en metros (100)
# DUPLICATE_SEARCH_RADIUS_METERS=100
